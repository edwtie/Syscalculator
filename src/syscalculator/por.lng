editor.nod_help.name=<div class="title">Name</div><div class="syntax">Name Celsius para Fahrenheit</div><div><b>Significado:</b> nome interno del convertitore.</div><div><b>Exemplo:</b> <code>Name Postcode para Address demo</code>.</div>
editor.nod_help.urln=<div class="title">URLN</div><div class="syntax">URLN TÃ­tulo do usuÃ¡rio</div><div><b>Significado:</b> titolo o descrizione visibile per l utente.</div><div><b>Exemplo:</b> <code>URLN Phone renumbering 1995 complete</code>.</div>
editor.nod_help.input1=<div class="title">input1</div><div class="syntax">input1 Celsius</div><div><b>Significado:</b> etichetta del valore di input.</div><div><b>Exemplo:</b> <code>input1 Old phone number</code>.</div>
editor.nod_help.input2=<div class="title">input2</div><div class="syntax">input2 Fahrenheit</div><div><b>Significado:</b> etichetta del valore di output.</div><div><b>Exemplo:</b> <code>input2 New phone number</code>.</div>
editor.nod_help.symb1=<div class="title">Symb1</div><div class="syntax">Symb1 DM</div><div><b>Significado:</b> symbol a sinistra input1.</div><div><b>Exemplo:</b> <code>Symb1 DM</code> -> <code>DM 25</code>.</div>
editor.nod_help.symb2=<div class="title">Symb2</div><div class="syntax">Symb2 EUR</div><div><b>Significado:</b> symbol a sinistra input2/output.</div><div><b>Exemplo:</b> <code>Symb2 EUR</code> -> <code>EUR 12.78</code>.</div>
editor.nod_help.symb3=<div class="title">Symb3</div><div class="syntax">Symb3 kg</div><div><b>Significado:</b> simbolo a destra di input1.</div><div><b>Exemplo:</b> <code>Symb3 kg</code> -> <code>25 kg</code>.</div>
editor.nod_help.symb4=<div class="title">Symb4</div><div class="syntax">Symb4 lb</div><div><b>Significado:</b> simbolo a destra di input2/output.</div><div><b>Exemplo:</b> <code>Symb4 lb</code> -> <code>55 lb</code>.</div>
editor.nod_help.format=<div class="title">format</div><div class="syntax">format ##.00</div><div><b>Significado:</b> controlla i decimali del risultato.</div><div><b>Exemplo:</b> <code>format ##.00</code> -> <code>12.50</code>.</div>
editor.nod_help.mode=<div class="title">mode</div><div class="syntax">mode calculator</div><div><b>Significado:</b> impostazione extra per tipo convertitore.</div><div><b>Exemplo:</b> <code>mode calculator</code>.</div>
editor.nod_help.math=<div class="title">math</div><div class="syntax">math ans * 1.8</div><div><b>Significado:</b> esegue un passo di calcolo con <code>ans</code> come valore corrente.</div><div><b>Exemplo:</b> <code>math ans + 32</code>.</div>
editor.nod_help.chg=<div class="title">chg</div><div class="syntax">chg "old-prefix","new-prefix"</div><div><b>Significado:</b> cambia l inizio del testo, ad esempio codici o telefoni.</div><div><b>Exemplo:</b> <code>chg "01751-xxxxx","070-51xxxxx"</code>.</div><div><b>Patterns:</b> <code>x</code> puÃ² catturare cifre; vince la regola piÃ¹ specifica.</div>
editor.nod_help.trans=<div class="title">trans</div><div class="syntax">trans "valor antigo","valor novo"</div><div><b>Significado:</b> traduz um valor de texto completo.</div><div><b>Exemplo:</b> <code>trans "olÃ¡","hello"</code>.</div>
editor.nod_help.trans.improved=<h2>trans melhorado: mais inteligente que NOD 1.0</h2><div class="notice improved"><b>CompatÃ­vel:</b> o <code>trans</code> clÃ¡ssico do NOD 1.0 procura primeiro correspondÃªncia exata. O NOD 2.0 sÃ³ depois tenta uma correspondÃªncia compacta inteligente.</div><table class="syntax-compare"><tr><th>Comportamento</th><th>NOD 1.0</th><th>NOD 2.0</th><th>Exemplo</th></tr><tr><td>Valor exato</td><td><span class="yes">&#10003;</span></td><td><span class="yes">&#10003;</span></td><td><code>trans "hallo","hello"</code></td></tr><tr><td>Ignorar maiÃºsculas/minÃºsculas</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>Hallo</code> corresponde a <code>hallo</code></td></tr><tr><td>Ignorar espaÃ§os, pontos, hÃ­fens e underscore</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>dank_je</code>, <code>dank je</code> e <code>dank-je</code> podem usar a mesma regra</td></tr><tr><td>CorrespondÃªncia ambÃ­gua</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td>Com duas correspondÃªncias compactas, o texto nÃ£o Ã© traduzido errado em silÃªncio.</td></tr></table>
editor.nod_help.reverse=<div class="title">reverse</div><div class="syntax">reverse ans / 1.8</div><div><b>Significado:</b> regola manuale di calcolo inverso.</div><div><b>Exemplo:</b> <code>reverse ans / 1.8</code>.</div>
editor.nod_help.field=<div class="title">field</div><div class="syntax">field ColumnName</div><div><b>Significado:</b> avvia una definizione campo dati.</div><div><b>Exemplo:</b> <code>field Phone</code>.</div>
editor.nod_help.table=<div class="title">table</div><div class="syntax">table TableName</div><div><b>Significado:</b> nome della tabella sorgente.</div><div><b>Exemplo:</b> <code>table Customers</code>.</div>
editor.nod_help.output=<div class="title">output</div><div class="syntax">output ResultColumn</div><div><b>Significado:</b> nome del campo output.</div><div><b>Exemplo:</b> <code>output PhoneNew</code>.</div>
editor.nod_help.phoneformat=<div class="title">phoneformat</div><div class="syntax">phoneformat country NL</div><div><b>Significado:</b> normaliza nÃºmeros de telefone dentro de um bloco <code>field</code> em <code>mode data</code>.</div><div><b>Exemplo:</b> <code>phoneformat remove_spaces true</code> remove espaÃ§os; <code>phoneformat normalize_international true</code> normaliza a notaÃ§Ã£o internacional neerlandesa.</div>
editor.nod_help.lookup=<div class="title">lookup</div><div class="syntax">lookup Countries</div><div><b>Significado:</b> avvia una definizione lookup.</div><div><b>Exemplo:</b> <code>lookup Countries</code>.</div>
editor.nod_help.match=<div class="title">match</div><div class="syntax">match code = NL</div><div><b>Significado:</b> descrive come viene trovato un lookup.</div><div><b>Exemplo:</b> <code>match postcode = 2566GB</code>.</div>
editor.nod_help.given=<div class="title">given</div><div class="syntax">given x = 10</div><div><b>Significado:</b> valore noto per un equazione.</div><div><b>Exemplo:</b> <code>given y = 20</code>.</div>
editor.nod_help.equation=<div class="title">equation</div><div class="syntax">equation y = x * 2</div><div><b>Significado:</b> definisce un equazione.</div><div><b>Exemplo:</b> <code>equation y = x * 2</code>.</div>
editor.nod_help.solve=<div class="title">solve</div><div class="syntax">solve x</div><div><b>Significado:</b> indica quale variabile risolvere.</div><div><b>Exemplo:</b> <code>solve x</code>.</div>
editor.nod_help.constraint=<div class="title">constraint</div><div class="syntax">constraint x >= 0</div><div><b>Significado:</b> condizione per una soluzione.</div><div><b>Exemplo:</b> <code>constraint x >= 0</code>.</div>
editor.nod_help.preview=<div class="title">preview</div><div class="syntax">preview Example text</div><div><b>Significado:</b> testo per anteprima/esempio.</div><div><b>Exemplo:</b> <code>preview Enter 2566 GB 241</code>.</div>
editor.nod_help.backup=<div class="title">backup</div><div class="syntax">backup true</div><div><b>Significado:</b> impostazione compatibilitÃ  da vecchi file NOD.</div><div><b>Exemplo:</b> <code>backup true</code>.</div>
editor.nod_help.indoprint=<div class="title">indoprint</div><div class="syntax">indoprint Texto de introduÃ§Ã£o</div><div><b>Significado:</b> linha de texto introdutÃ³rio mostrada antes do uso.</div><div><b>Exemplo:</b> <code>indoprint Texto de introduÃ§Ã£o</code>; <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a> fecha o bloco.</div>
editor.nod_help.indoend=<div class="title">indoend</div><div class="syntax">indoend</div><div><b>Significado:</b> fine del blocco introduttivo.</div><div><b>Exemplo:</b> <code>indoprint ...</code> + <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</div>
editor.nod_help.end=<div class="title">end</div><div class="syntax">end</div><div><b>Significado:</b> fine del file NOD.</div><div><b>Exemplo:</b> metti <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> come ultima riga.</div>
editor.nod_help.insert=Inserir
editor.nod_insert.indoprint=indoprint Texto de introduÃ§Ã£o\nindoend
