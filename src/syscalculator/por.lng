editor.nod_help.suggestions=Sugestões
help.nod_screenshot.converter_name=Celsius para Fahrenheit
help.nod_screenshot.decimal_factor=1.8
help.nod_screenshot.meaning_label=Significado:
help.nod_screenshot.name_meaning=nome interno do conversor.
help.nod_screenshot.example_label=Exemplo:
help.nod_screenshot.example_name=Name Codigo postal para endereco demo
editor.nod_help.name=<div class="title">Name</div><div class="syntax">Name Celsius para Fahrenheit</div><div><b>Significado:</b> nome interno del convertitore.</div><div><b>Exemplo:</b> <code>Name Postcode para Address demo</code>.</div>
editor.nod_help.urln=<div class="title">URLN</div><div class="syntax">URLN Título do usuário</div><div><b>Significado:</b> titolo o descrizione visibile per l utente.</div><div><b>Exemplo:</b> <code>URLN Phone renumbering 1995 complete</code>.</div>
editor.nod_help.input1=<div class="title">input1</div><div class="syntax">input1 Celsius</div><div><b>Significado:</b> etichetta del valore di input.</div><div><b>Exemplo:</b> <code>input1 Old phone number</code>.</div>
editor.nod_help.input2=<div class="title">input2</div><div class="syntax">input2 Fahrenheit</div><div><b>Significado:</b> etichetta del valore di output.</div><div><b>Exemplo:</b> <code>input2 New phone number</code>.</div>
editor.nod_help.symb1=<div class="title">Symb1</div><div class="syntax">Symb1 DM</div><div><b>Significado:</b> symbol a sinistra input1.</div><div><b>Exemplo:</b> <code>Symb1 DM</code> -> <code>DM 25</code>.</div>
editor.nod_help.symb2=<div class="title">Symb2</div><div class="syntax">Symb2 EUR</div><div><b>Significado:</b> symbol a sinistra input2/output.</div><div><b>Exemplo:</b> <code>Symb2 EUR</code> -> <code>EUR 12.78</code>.</div>
editor.nod_help.symb3=<div class="title">Symb3</div><div class="syntax">Symb3 kg</div><div><b>Significado:</b> simbolo a destra di input1.</div><div><b>Exemplo:</b> <code>Symb3 kg</code> -> <code>25 kg</code>.</div>
editor.nod_help.symb4=<div class="title">Symb4</div><div class="syntax">Symb4 lb</div><div><b>Significado:</b> simbolo a destra di input2/output.</div><div><b>Exemplo:</b> <code>Symb4 lb</code> -> <code>55 lb</code>.</div>
editor.nod_help.format=<div class="title">format</div><div class="syntax">format ##.00</div><div><b>Significado:</b> controlla i decimali del risultato.</div><div><b>Exemplo:</b> <code>format ##.00</code> -> <code>12.50</code>.</div>
editor.nod_help.mode=<div class="title">mode</div><div class="syntax">mode calculator</div><div><b>Significado:</b> impostazione extra per tipo convertitore.</div><div><b>Exemplo:</b> <code>mode calculator</code>.</div>
editor.nod_help.math=<div class="title">math</div><div class="syntax">math ans * 1.8</div><div><b>Significado:</b> esegue un passo di calcolo con <code>ans</code> come valore corrente.</div><div><b>Exemplo:</b> <code>math ans + 32</code>.</div>
editor.nod_help.chg=<div class="title">chg</div><div class="syntax">chg "old-prefix","new-prefix"</div><div><b>Significado:</b> cambia l inizio del testo, ad esempio codici o telefoni.</div><div><b>Exemplo:</b> <code>chg "01751-xxxxx","070-51xxxxx"</code>.</div><div><b>Patterns:</b> <code>x</code> può catturare cifre; vince la regola più specifica.</div>
editor.nod_help.trans=<div class="title">trans</div><div class="syntax">trans "valor antigo","valor novo"</div><div><b>Significado:</b> traduz um valor de texto completo.</div><div><b>Exemplo:</b> <code>trans "olá","hello"</code>.</div>
editor.nod_help.trans.improved=<h2>trans melhorado: mais inteligente que NOD 1.0</h2><div class="notice improved"><b>Compatível:</b> o <code>trans</code> clássico do NOD 1.0 procura primeiro correspondência exata. O NOD 2.0 só depois tenta uma correspondência compacta inteligente.</div><table class="syntax-compare"><tr><th>Comportamento</th><th>NOD 1.0</th><th>NOD 2.0</th><th>Exemplo</th></tr><tr><td>Valor exato</td><td><span class="yes">&#10003;</span></td><td><span class="yes">&#10003;</span></td><td><code>trans "hallo","hello"</code></td></tr><tr><td>Ignorar maiúsculas/minúsculas</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>Hallo</code> corresponde a <code>hallo</code></td></tr><tr><td>Ignorar espaços, pontos, hífens e underscore</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>dank_je</code>, <code>dank je</code> e <code>dank-je</code> podem usar a mesma regra</td></tr><tr><td>Correspondência ambígua</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td>Com duas correspondências compactas, o texto não é traduzido errado em silêncio.</td></tr></table>
editor.nod_help.reverse=<div class="title">reverse</div><div class="syntax">reverse ans / 1.8</div><div><b>Significado:</b> regola manuale di calcolo inverso.</div><div><b>Exemplo:</b> <code>reverse ans / 1.8</code>.</div>
editor.nod_help.field=<div class="title">field</div><div class="syntax">field ColumnName</div><div><b>Significado:</b> avvia una definizione campo dati.</div><div><b>Exemplo:</b> <code>field Phone</code>.</div>
editor.nod_help.table=<div class="title">table</div><div class="syntax">table TableName</div><div><b>Significado:</b> nome della tabella sorgente.</div><div><b>Exemplo:</b> <code>table Customers</code>.</div>
editor.nod_help.output=<div class="title">output</div><div class="syntax">output ResultColumn</div><div><b>Significado:</b> nome del campo output.</div><div><b>Exemplo:</b> <code>output PhoneNew</code>.</div>
editor.nod_help.phoneformat=<div class="title">phoneformat</div><div class="syntax">phoneformat country NL</div><div><b>Significado:</b> normaliza números de telefone dentro de um bloco <code>field</code> em <code>mode data</code>.</div><div><b>Exemplo:</b> <code>phoneformat remove_spaces true</code> remove espaços; <code>phoneformat normalize_international true</code> normaliza a notação internacional neerlandesa.</div>
editor.nod_help.lookup=<div class="title">lookup</div><div class="syntax">lookup Countries</div><div><b>Significado:</b> avvia una definizione lookup.</div><div><b>Exemplo:</b> <code>lookup Countries</code>.</div>
editor.nod_help.match=<div class="title">match</div><div class="syntax">match code = NL</div><div><b>Significado:</b> descrive come viene trovato un lookup.</div><div><b>Exemplo:</b> <code>match postcode = 2566GB</code>.</div>
editor.nod_help.given=<div class="title">given</div><div class="syntax">given x = 10</div><div><b>Significado:</b> valore noto per un equazione.</div><div><b>Exemplo:</b> <code>given y = 20</code>.</div>
editor.nod_help.equation=<div class="title">equation</div><div class="syntax">equation y = x * 2</div><div><b>Significado:</b> definisce un equazione.</div><div><b>Exemplo:</b> <code>equation y = x * 2</code>.</div>
editor.nod_help.solve=<div class="title">solve</div><div class="syntax">solve x</div><div><b>Significado:</b> indica quale variabile risolvere.</div><div><b>Exemplo:</b> <code>solve x</code>.</div>
editor.nod_help.constraint=<div class="title">constraint</div><div class="syntax">constraint x >= 0</div><div><b>Significado:</b> condizione per una soluzione.</div><div><b>Exemplo:</b> <code>constraint x >= 0</code>.</div>
editor.nod_help.preview=<div class="title">preview</div><div class="syntax">preview Example text</div><div><b>Significado:</b> testo per anteprima/esempio.</div><div><b>Exemplo:</b> <code>preview Enter 2566 GB 241</code>.</div>
editor.nod_help.backup=<div class="title">backup</div><div class="syntax">backup true</div><div><b>Significado:</b> impostazione compatibilità da vecchi file NOD.</div><div><b>Exemplo:</b> <code>backup true</code>.</div>
editor.nod_help.indoprint=<div class="title">indoprint</div><div class="syntax">indoprint Texto de introdução</div><div><b>Significado:</b> linha de texto introdutório mostrada antes do uso.</div><div><b>Exemplo:</b> <code>indoprint Texto de introdução</code>; <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a> fecha o bloco.</div>
editor.nod_help.indoend=<div class="title">indoend</div><div class="syntax">indoend</div><div><b>Significado:</b> fine del blocco introduttivo.</div><div><b>Exemplo:</b> <code>indoprint ...</code> + <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</div>
editor.nod_help.end=<div class="title">end</div><div class="syntax">end</div><div><b>Significado:</b> fine del file NOD.</div><div><b>Exemplo:</b> metti <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> come ultima riga.</div>
editor.nod_help.insert=Inserir
editor.nod_insert.indoprint=indoprint Texto de introdução\nindoend
editor.menu.help=Help
editor.menu.help.nod=NOD help

editor.menu.help.about=Sobre o editor NOD
editor.nod_help.more=Mais ajuda
editor.nod_help.full.title=Ajuda NOD
editor.nod_help.full.keyword_title=Referência de comandos
editor.nod_help.full.intro=<p><b>NOD</b> é a linguagem que descreve conversores Syscalculator: nome da janela, campos visíveis, símbolos perto dos valores e regras de conversão.</p><p>O editor NOD torna isso visível: sugestões ao digitar, ajuda com clique direito, painel de teste em baixo e pré-visualização do conversor à direita.</p>
editor.nod_help.full.structure=<h2>Estrutura básica</h2><pre>Name Celsius para Fahrenheit&#13;&#10;URLN Celsius para Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format ##.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre>
editor.nod_help.full.symbols=<h2>Símbolos</h2><table><tr><th>Comando</th><th>Posizione</th><th>Exemplo</th></tr><tr><td>Symb1</td><td>a sinistra input</td><td>DM 25</td></tr><tr><td>Symb2</td><td>a sinistra output</td><td>EUR 25</td></tr><tr><td>Symb3</td><td>a destra input</td><td>25 kg</td></tr><tr><td>Symb4</td><td>a destra output</td><td>25 lb</td></tr></table><p>Scegli sinistra o destra per valore, non entrambi, per evitare testo doppio come <code>DM 25 DM</code>.</p>
editor.nod_help.full.commands=<h2>Comandos importantes</h2><ul><li><b>math</b>: calcola con <code>ans</code>.</li><li><b>trans</b>: traduce valori di testo esatti.</li><li><b>chg</b>: cambia testo iniziale/prefisso e supporta pattern <code>x</code>.</li><li><b>indoprint ... indoend</b>: blocco di testo introduttivo. Non dimenticare <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</li><li><b>end</b>: chiude il file NOD.</li></ul>
editor.nod_help.full.workflow=<h2>Fluxo de trabalho</h2><ol><li>Inizia con <a class="cmd-link" href="nodpage:cmd:name"><code>Name</code></a>, <a class="cmd-link" href="nodpage:cmd:input1"><code>input1</code></a> e <a class="cmd-link" href="nodpage:cmd:input2"><code>input2</code></a>.</li><li>Scegli i simboli con <a class="cmd-link" href="nodpage:cmd:symb1"><code>Symb1</code></a> fino a <a class="cmd-link" href="nodpage:cmd:symb4"><code>Symb4</code></a>; sinistra o destra, non entrambi.</li><li>Aggiungi regole: <a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a>, <a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a> o <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a>.</li><li>Usa Valida/F5 e Test/F6.</li><li>Metti <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> alla fine.</li></ol>
editor.nod_help.full.examples=<h2>Exemplos por tipo NOD</h2><p>I file NOD possono descrivere diversi tipi di convertitori.</p><h3>1. Strumento di calcolo con math</h3><p>Per numeri: temperatura, distanza, peso, valuta, percentuale.</p><pre>Name Celsius para Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format ##.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre><h3>2. Strumento di traduzione con trans</h3><p>Usalo quando tutto l input deve corrispondere a un valore noto.</p><pre>Name Postcode para Address demo&#13;&#10;input1 Postcode house number&#13;&#10;input2 Address&#13;&#10;trans "2566 GB 241","Nieboerweg 241, 2566 GB Den Haag"&#13;&#10;end</pre><h3>3. Strumento prefisso/pattern con chg</h3><p>Usa <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a> quando cambia solo l inizio o il pattern.</p><pre>Name Operation Decibel demo&#13;&#10;input1 Old phone number&#13;&#10;input2 New phone number&#13;&#10;chg "01751-xxxxx","070-51xxxxx"&#13;&#10;chg "050-2xxxxx","050-52xxxxx"&#13;&#10;end</pre><h3>4. Strumento con simboli sinistra/destra</h3><p>Usa simboli per mostrare bene le unità.</p><pre>Name German mark para euro&#13;&#10;input1 Mark&#13;&#10;input2 Euro&#13;&#10;Symb1 DM&#13;&#10;Symb2 EUR&#13;&#10;format ##.00&#13;&#10;math ans / 1.95583&#13;&#10;end</pre><h3>5. Testo introduttivo con indoprint</h3><p>Usalo quando l utente deve prima vedere istruzioni.</p><pre>indoprint Questo convertitore cambia Celsius in Fahrenheit.&#13;&#10;indoprint Inserisci una temperatura in gradi Celsius.&#13;&#10;indoend</pre><h3>6. Risoluzione equazione con equation</h3><p>Per problemi di formula con variabile sconosciuta da risolvere.</p><pre>Name Solve equation&#13;&#10;given y = 20&#13;&#10;equation y = x * 2&#13;&#10;solve x&#13;&#10;constraint x >= 0&#13;&#10;end</pre>
editor.nod_help.full.troubleshooting=<h2>Erros comuns</h2><ul><li><b>Simboli doppi:</b> non usare simboli sinistra e destra per lo stesso valore.</li><li><b>Introduzione senza fine:</b> chiudi ogni blocco <a class="cmd-link" href="nodpage:cmd:indoprint"><code>indoprint</code></a> con <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</li><li><b>Math senza ans:</b> usa <code>ans</code> come valore corrente.</li><li><b>Nessun end:</b> metti <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> alla fine del file.</li><li><b>Virgola/punto:</b> testa sempre i decimali con F6.</li></ul>
editor.nod_help.page.workflow=Fluxo de trabalho
editor.nod_help.page.history=Histórico
editor.nod_help.page.structure=Estrutura básica
editor.nod_help.page.symbols=Símbolos
editor.nod_help.page.commands=Comandos importantes
editor.nod_help.page.examples=Exemplos
editor.nod_help.page.troubleshooting=Erros comuns


editor.nod_help.chg.extra=<h2>Exemplos chg</h2><p><a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a> altera o início do texto ou um padrão. É útil para telefones, códigos, prefixos e tabelas de renumeração.</p><div class="notice"><b>Estrutura:</b> esquerda = o que procurar, direita = nova forma. Use aspas para espaços, vírgulas ou caracteres especiais.</div><details open><summary>Substituir prefixo</summary><table><tr><th>Objetivo</th><th>Regra</th><th>Exemplo</th></tr><tr><td>Prefix</td><td><code>chg "01751","07051"</code></td><td><code>0175112345</code> -> <code>0705112345</code></td></tr><tr><td>Dash</td><td><code>chg "01751-","070-51"</code></td><td><code>01751-12345</code> -> <code>070-5112345</code></td></tr></table></details><details><summary>Padrão com x</summary><p>NOD 2.0: <code>x</code> captura um dígito e o coloca de volta à direita. Espaços e hífens à esquerda são apenas para leitura.</p><pre>chg "0183x-xx xx","0183-x0 xx xx"</pre><p><code>01835-1234</code> -> <code>0183-501234</code>.</p></details><details><summary>Erros comuns</summary><ul><li>Coloque regras específicas acima de regras gerais.</li><li>Não esqueça a vírgula.</li><li>Use <a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a> para tradução de valor completo.</li></ul></details>
editor.nod_help.math.extra=<h2>Math em resumo</h2><p><a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a> calcula com <code>ans</code>. Na primeira linha <code>ans</code> é o valor de entrada; nas linhas seguintes é o resultado anterior.</p><div class="notice"><b>Estrutura:</b> escolha primeiro o tipo de cálculo e depois escreva a syntax correta. Para fórmulas grandes, use parênteses ou várias linhas <a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a>.</div><div class="math-flow"><span class="math-pill">1. Operações básicas</span><span class="math-pill">2. Funções e constantes</span><span class="math-pill">3. Fórmulas complexas</span><span class="math-pill">4. Cálculo: diff, integral, limite</span></div><details open><summary>Operações básicas</summary><table><tr><th>Objetivo</th><th>Syntax</th><th>Exemplo</th></tr><tr><td>+</td><td><code>math ans + number</code></td><td><code>math ans + 32</code></td></tr><tr><td>-</td><td><code>math ans - number</code></td><td><code>math ans - 10</code></td></tr><tr><td>*</td><td><code>math ans * factor</code></td><td><code>math ans * 1.8</code></td></tr><tr><td>/</td><td><code>math ans / factor</code></td><td><code>math ans / 1.95583</code></td></tr></table><pre>Name Euro to cents&#13;&#10;input1 Euro&#13;&#10;input2 Cents&#13;&#10;format #.00&#13;&#10;math ans * 100&#13;&#10;end</pre></details><details><summary>Funções e constantes</summary><table><tr><th>Groep</th><th>Syntax</th><th>Nota</th></tr><tr><td>Power</td><td><code>math ans^2</code> or <code>math pow(ans,3)</code></td><td>Square, cube.</td></tr><tr><td>Root</td><td><code>math sqrt(ans)</code></td><td>Can be used inside formulas.</td></tr><tr><td>Pi/e</td><td><code>math pi * ans^2</code><br><code>math e^ans</code></td><td>Circle and exponential.</td></tr><tr><td>Degrees</td><td><code>math sind(ans)</code><br><code>math cosd(ans)</code></td><td>Use <code>sin/cos/tan</code> for radians.</td></tr></table></details><details><summary>Fórmulas complexas</summary><p>Use parênteses quando a ordem for importante. Escreva sempre a multiplicação com <code>*</code>.</p><pre>math sqrt(ans^2 + 25)&#13;&#10;math ((ans + 10) * 2) / 3&#13;&#10;math ans * (1 + 0.04)^5</pre><h3>Exemplo: Pitágoras</h3><div class="mathml-formula"><math xmlns="http://www.w3.org/1998/Math/MathML" display="inline"><mrow><mi>c</mi><mo>=</mo><msqrt><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mn>5</mn><mn>2</mn></msup></mrow></msqrt></mrow></math></div><pre>Name Hypotenuse&#13;&#10;input1 Side a&#13;&#10;input2 Side c&#13;&#10;format #.00&#13;&#10;math sqrt(ans^2 + 25)&#13;&#10;end</pre><p>Aqui <code>ans</code> é o lado <code>a</code>; o outro lado fica fixo em <code>5</code>.</p></details><details><summary>Cálculo: diff, integral, limite</summary><table><tr><th>Objetivo</th><th>Syntax</th><th>Resultado</th></tr><tr><td>Derivative</td><td><code>math diff ans^2</code></td><td>Inclinação numérica.</td></tr><tr><td>Integral</td><td><code>math integral 0,1 ans^2</code></td><td>Área numérica de 0 a 1.</td></tr><tr><td>Limit</td><td><code>math limit 0 sin(ans)/ans</code></td><td>Aproximação em torno de 0.</td></tr></table></details><h2>Erros comuns</h2><ul><li>Não esqueça <code>ans</code>.</li><li>Use <code>sind</code> para graus.</li><li>Use <a class="cmd-link" href="nodpage:cmd:reverse"><code>reverse</code></a> para conversão inversa complexa.</li></ul>
editor.nod_help.mode.extra=<h2>Quando usar mode?</h2><p><a class="cmd-link" href="nodpage:cmd:mode"><code>mode</code></a> indica que tipo de arquivo NOD você está criando. Para um conversor normal, geralmente não é necessário.</p><div class="notice"><b>Estrutura:</b> use <a class="cmd-link" href="nodpage:cmd:mode"><code>mode</code></a> apenas para tipos especiais, como processamento de dados ou resolução de equações.</div><details open><summary>Modes</summary><table><tr><th>Mode</th><th>Quando</th><th>Comandos</th></tr><tr><td><code>mode calculator</code></td><td>Conversor normal</td><td><a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a>, <a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a>, <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a></td></tr><tr><td><code>mode data</code></td><td>Processamento de dados</td><td><a class="cmd-link" href="nodpage:cmd:table"><code>table</code></a>, <a class="cmd-link" href="nodpage:cmd:field"><code>field</code></a>, <a class="cmd-link" href="nodpage:cmd:output"><code>output</code></a></td></tr><tr><td><code>mode equation</code></td><td>Resolver equação</td><td><a class="cmd-link" href="nodpage:cmd:given"><code>given</code></a>, <a class="cmd-link" href="nodpage:cmd:equation"><code>equation</code></a>, <a class="cmd-link" href="nodpage:cmd:solve"><code>solve</code></a></td></tr></table></details><details><summary>Exemplo: converter</summary><pre>Name Celsius to Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format #.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre></details><details><summary>Exemplo: equation</summary><pre>Name Solve equation&#13;&#10;mode equation&#13;&#10;given y = 20&#13;&#10;equation y = x * 2&#13;&#10;solve x&#13;&#10;constraint x >= 0&#13;&#10;end</pre></details>
editor.nod_help.trans.extra=<h2>Exemplos trans</h2><p><a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a> traduz um valor completo. Use para palavras, códigos fixos, estados, códigos postais e listas curtas.</p><div class="notice"><b>Estrutura:</b> <code>trans "old value","new value"</code>. A entrada completa deve corresponder ao valor à esquerda.</div><details open><summary>Traduzir texto exato</summary><table><tr><th>Objetivo</th><th>Regra</th><th>Resultado</th></tr><tr><td>Word</td><td><code>trans "hallo","hello"</code></td><td><code>hallo</code> -> <code>hello</code></td></tr><tr><td>Status</td><td><code>trans "open","in progress"</code></td><td><code>open</code> -> <code>in progress</code></td></tr><tr><td>Address</td><td><code>trans "2566 GB 241","Nieboerweg 241, 2566 GB Den Haag"</code></td><td>postcode + house number -> address</td></tr></table></details><details><summary>trans / chg</summary><table><tr><th>Comando</th><th>Quando</th><th>Exemplo</th></tr><tr><td><a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a></td><td>A entrada completa é conhecida exatamente.</td><td><code>hallo</code> -> <code>hello</code></td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a></td><td>Só o início ou o padrão muda.</td><td><code>01751-xxxxx</code> -> <code>070-51xxxxx</code></td></tr></table></details><details><summary>Erros comuns</summary><ul><li>Esquerda é entrada, direita é saída.</li><li>Use <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a> para mudanças parciais.</li><li>Evite traduções duplicadas para a mesma entrada.</li></ul></details>
editor.nod_help.full.classic=<h2>Introdução ao editor NOD</h2><p>O editor NOD é o espaço de trabalho dos conversores. O código fica em cima, os testes em baixo e a pré-visualização à direita mostra rótulos, símbolos, texto introdutório e resultados.</p><h2>Clássico 1.73 e NOD 2.0</h2><table><tr><th>Syscalculator 1.73 / NOD 1.0</th><th>Syscalculator 2.0 / editor NOD</th></tr><tr><td>Arquivos de texto clássicos com <a class="cmd-link" href="nodpage:cmd:name"><code>Name</code></a>, <a class="cmd-link" href="nodpage:cmd:input1"><code>input1</code></a>, <a class="cmd-link" href="nodpage:cmd:input2"><code>input2</code></a>, <a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a>, <a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a>, <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a> e <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a>.</td><td>A mesma base continua compatível com arquivos NOD antigos.</td></tr><tr><td>A posição dos símbolos muitas vezes precisava ser lembrada e testada.</td><td>A pré-visualização mostra imediatamente <a class="cmd-link" href="nodpage:cmd:symb1"><code>Symb1</code></a> até <a class="cmd-link" href="nodpage:cmd:symb4"><code>Symb4</code></a>.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a> era principalmente troca de prefixo.</td><td><a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a> continua compatível; NOD 2.0 adiciona padrões com capture <code>x</code>.</td></tr><tr><td>A ajuda vinha principalmente de exemplos.</td><td>O editor oferece sugestões, ajuda com clique direito e páginas de exemplos.</td></tr></table><h2>Sintaxe: visão geral completa do NOD 1.0 e NOD 2.0</h2><p>Esta tabela mostra qual sintaxe vem dos arquivos NOD clássicos e o que foi adicionado no NOD 2.0.</p><table class="syntax-compare"><tr><th>Syntax / feature</th><th>NOD 1.0</th><th>NOD 2.0</th><th>Note</th></tr><tr><td><a class="cmd-link" href="nodpage:cmd:name"><code>Name</code></a></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Converter name/title.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:urln"><code>URLN</code></a></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Reference/source line remains supported.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:input1"><code>input1</code></a>, <a class="cmd-link" href="nodpage:cmd:input2"><code>input2</code></a></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Labels for input and output.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:result"><code>Result</code></a>, <a class="cmd-link" href="nodpage:cmd:resfou"><code>Resfou</code></a></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Result label and error text.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:symb1"><code>Symb1</code></a> through <a class="cmd-link" href="nodpage:cmd:symb4"><code>Symb4</code></a></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Symbols left/right of input and output; NOD 2.0 shows them in preview.</td></tr><tr><td><code>format #.00</code></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Number formatting stays the same.</td></tr><tr><td><code>mode calculator</code></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>NOD 2.0 uses <a class="cmd-link" href="nodpage:cmd:mode"><code>mode</code></a> for special file types; normal converters also work without mode.</td></tr><tr><td><code>mode data</code></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>For table/field processing.</td></tr><tr><td><code>mode equation</code></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>For solving equations with <a class="cmd-link" href="nodpage:cmd:given"><code>given</code></a>, <a class="cmd-link" href="nodpage:cmd:equation"><code>equation</code></a>, <a class="cmd-link" href="nodpage:cmd:solve"><code>solve</code></a>.</td></tr><tr><td><code>math ans * 1.8</code></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Classic calculation with <code>ans</code>.</td></tr><tr><td><code>math sqrt(ans^2 + 25)</code></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>Richer formulas and functions in NOD 2.0.</td></tr><tr><td><code>chg "01751-","070-51"</code></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Classic prefix replacement keeps working.</td></tr><tr><td><code>chg "0183x-xx xx","0183-x0 xx xx"</code></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>New in NOD 2.0: pattern with <code>x</code> capture.</td></tr><tr><td><code>trans "old","new"</code></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Exact text translation remains compatible.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:reverse"><code>reverse</code></a></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Reverse direction of a converter.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:table"><code>table</code></a>, <a class="cmd-link" href="nodpage:cmd:field"><code>field</code></a>, <a class="cmd-link" href="nodpage:cmd:output"><code>output</code></a></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>NOD 2.0 data converters with fields and output construction.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:phoneformat"><code>phoneformat</code></a></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>Format phone numbers in data/number converters.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:lookup"><code>lookup</code></a>, <a class="cmd-link" href="nodpage:cmd:match"><code>match</code></a></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>Look up tables or connect values.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:given"><code>given</code></a>, <a class="cmd-link" href="nodpage:cmd:equation"><code>equation</code></a>, <a class="cmd-link" href="nodpage:cmd:solve"><code>solve</code></a>, <a class="cmd-link" href="nodpage:cmd:constraint"><code>constraint</code></a></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>Solve equations with constraints.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:preview"><code>preview</code></a>, <a class="cmd-link" href="nodpage:cmd:backup"><code>backup</code></a></td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>Editor/safety information for NOD 2.0 files.</td></tr><tr><td><code>indoprint ... indoend</code></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Introduction text remains supported.</td></tr><tr><td><a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a></td><td><span class="yes">✓</span></td><td><span class="yes">✓</span></td><td>Closes the NOD file.</td></tr><tr><td>Live preview, suggestions, right-click help</td><td><span class="no">×</span></td><td><span class="yes">✓</span></td><td>This is editor help, not old runtime syntax.</td></tr></table><h2>O que continua</h2><ul><li>Comandos legíveis por linha.</li><li><a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> fecha o arquivo.</li><li>Um conversor simples continua curto.</li></ul><h2>O que é novo</h2><ul><li>Pré-visualização ao vivo e simulador.</li><li>Graph 2D para gráficos de conversores math.</li><li>Sugestões ao digitar.</li><li>Ajuda mais completa por comando.</li><li>Mais exemplos para <a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a>, <a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a>, <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a>, símbolos e <a class="cmd-link" href="nodpage:cmd:indoprint"><code>indoprint</code></a>.</li></ul>
