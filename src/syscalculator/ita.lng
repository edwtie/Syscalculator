editor.nod_help.suggestions=Suggerimenti
help.nod_screenshot.converter_name=Celsius a Fahrenheit
help.nod_screenshot.decimal_factor=1.8
help.nod_screenshot.meaning_label=Significato:
help.nod_screenshot.name_meaning=nome interno del convertitore.
help.nod_screenshot.example_label=Esempio:
help.nod_screenshot.example_name=Name Postcode a indirizzo demo
editor.nod_help.name=<div class="title">Name</div><div class="syntax">Name Celsius a Fahrenheit</div><div><b>Significato:</b> nome interno del convertitore.</div><div><b>Esempio:</b> <code>Name Postcode a Address demo</code>.</div>
editor.nod_help.urln=<div class="title">URLN</div><div class="syntax">URLN Titolo utente</div><div><b>Significato:</b> titolo o descrizione visibile per l utente.</div><div><b>Esempio:</b> <code>URLN Phone renumbering 1995 complete</code>.</div>
editor.nod_help.input1=<div class="title">input1</div><div class="syntax">input1 Celsius</div><div><b>Significato:</b> etichetta del valore di input.</div><div><b>Esempio:</b> <code>input1 Old phone number</code>.</div>
editor.nod_help.input2=<div class="title">input2</div><div class="syntax">input2 Fahrenheit</div><div><b>Significato:</b> etichetta del valore di output.</div><div><b>Esempio:</b> <code>input2 New phone number</code>.</div>
editor.nod_help.symb1=<div class="title">Symb1</div><div class="syntax">Symb1 DM</div><div><b>Significato:</b> symbol a sinistra input1.</div><div><b>Esempio:</b> <code>Symb1 DM</code> -> <code>DM 25</code>.</div>
editor.nod_help.symb2=<div class="title">Symb2</div><div class="syntax">Symb2 EUR</div><div><b>Significato:</b> symbol a sinistra input2/output.</div><div><b>Esempio:</b> <code>Symb2 EUR</code> -> <code>EUR 12.78</code>.</div>
editor.nod_help.symb3=<div class="title">Symb3</div><div class="syntax">Symb3 kg</div><div><b>Significato:</b> simbolo a destra di input1.</div><div><b>Esempio:</b> <code>Symb3 kg</code> -> <code>25 kg</code>.</div>
editor.nod_help.symb4=<div class="title">Symb4</div><div class="syntax">Symb4 lb</div><div><b>Significato:</b> simbolo a destra di input2/output.</div><div><b>Esempio:</b> <code>Symb4 lb</code> -> <code>55 lb</code>.</div>
editor.nod_help.format=<div class="title">format</div><div class="syntax">format ##.00</div><div><b>Significato:</b> controlla i decimali del risultato.</div><div><b>Esempio:</b> <code>format ##.00</code> -> <code>12.50</code>.</div>
editor.nod_help.mode=<div class="title">mode</div><div class="syntax">mode calculator</div><div><b>Significato:</b> impostazione extra per tipo convertitore.</div><div><b>Esempio:</b> <code>mode calculator</code>.</div>
editor.nod_help.math=<div class="title">math</div><div class="syntax">math ans * 1.8</div><div><b>Significato:</b> esegue un passo di calcolo con <code>ans</code> come valore corrente.</div><div><b>Esempio:</b> <code>math ans + 32</code>.</div>
editor.nod_help.chg=<div class="title">chg</div><div class="syntax">chg "old-prefix","new-prefix"</div><div><b>Significato:</b> cambia l inizio del testo, ad esempio codici o telefoni.</div><div><b>Esempio:</b> <code>chg "01751-xxxxx","070-51xxxxx"</code>.</div><div><b>Patterns:</b> <code>x</code> può catturare cifre; vince la regola più specifica.</div>
editor.nod_help.trans=<div class="title">trans</div><div class="syntax">trans "vecchio valore","nuovo valore"</div><div><b>Significato:</b> traduce un valore di testo completo.</div><div><b>Esempio:</b> <code>trans "ciao","hello"</code>.</div>
editor.nod_help.trans.improved=<h2>trans migliorato: più intelligente di NOD 1.0</h2><div class="notice improved"><b>Compatibile:</b> il <code>trans</code> classico di NOD 1.0 cerca prima una corrispondenza esatta. NOD 2.0 prova solo dopo una corrispondenza compatta.</div><table class="syntax-compare"><tr><th>Comportamento</th><th>NOD 1.0</th><th>NOD 2.0</th><th>Esempio</th></tr><tr><td>Valore esatto</td><td><span class="yes">&#10003;</span></td><td><span class="yes">&#10003;</span></td><td><code>trans "hallo","hello"</code></td></tr><tr><td>Ignora maiuscole/minuscole</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>Hallo</code> corrisponde a <code>hallo</code></td></tr><tr><td>Ignora spazi, punti, trattini e underscore</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>dank_je</code>, <code>dank je</code> e <code>dank-je</code> possono usare la stessa regola</td></tr><tr><td>Corrispondenza ambigua</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td>Con due corrispondenze compatte, il testo non viene tradotto in modo errato in silenzio.</td></tr></table>
editor.nod_help.reverse=<div class="title">reverse</div><div class="syntax">reverse ans / 1.8</div><div><b>Significato:</b> regola manuale di calcolo inverso.</div><div><b>Esempio:</b> <code>reverse ans / 1.8</code>.</div>
editor.nod_help.field=<div class="title">field</div><div class="syntax">field ColumnName</div><div><b>Significato:</b> avvia una definizione campo dati.</div><div><b>Esempio:</b> <code>field Phone</code>.</div>
editor.nod_help.table=<div class="title">table</div><div class="syntax">table TableName</div><div><b>Significato:</b> nome della tabella sorgente.</div><div><b>Esempio:</b> <code>table Customers</code>.</div>
editor.nod_help.output=<div class="title">output</div><div class="syntax">output ResultColumn</div><div><b>Significato:</b> nome del campo output.</div><div><b>Esempio:</b> <code>output PhoneNew</code>.</div>
editor.nod_help.phoneformat=<div class="title">phoneformat</div><div class="syntax">phoneformat country NL</div><div><b>Significato:</b> normalizza numeri telefonici dentro un blocco <code>field</code> in <code>mode data</code>.</div><div><b>Esempio:</b> <code>phoneformat remove_spaces true</code> rimuove gli spazi; <code>phoneformat normalize_international true</code> normalizza la notazione internazionale olandese.</div>
editor.nod_help.lookup=<div class="title">lookup</div><div class="syntax">lookup Countries</div><div><b>Significato:</b> avvia una definizione lookup.</div><div><b>Esempio:</b> <code>lookup Countries</code>.</div>
editor.nod_help.match=<div class="title">match</div><div class="syntax">match code = NL</div><div><b>Significato:</b> descrive come viene trovato un lookup.</div><div><b>Esempio:</b> <code>match postcode = 2566GB</code>.</div>
editor.nod_help.given=<div class="title">given</div><div class="syntax">given x = 10</div><div><b>Significato:</b> valore noto per un equazione.</div><div><b>Esempio:</b> <code>given y = 20</code>.</div>
editor.nod_help.equation=<div class="title">equation</div><div class="syntax">equation y = x * 2</div><div><b>Significato:</b> definisce un equazione.</div><div><b>Esempio:</b> <code>equation y = x * 2</code>.</div>
editor.nod_help.solve=<div class="title">solve</div><div class="syntax">solve x</div><div><b>Significato:</b> indica quale variabile risolvere.</div><div><b>Esempio:</b> <code>solve x</code>.</div>
editor.nod_help.constraint=<div class="title">constraint</div><div class="syntax">constraint x >= 0</div><div><b>Significato:</b> condizione per una soluzione.</div><div><b>Esempio:</b> <code>constraint x >= 0</code>.</div>
editor.nod_help.preview=<div class="title">preview</div><div class="syntax">preview Example text</div><div><b>Significato:</b> testo per anteprima/esempio.</div><div><b>Esempio:</b> <code>preview Enter 2566 GB 241</code>.</div>
editor.nod_help.backup=<div class="title">backup</div><div class="syntax">backup true</div><div><b>Significato:</b> impostazione compatibilità da vecchi file NOD.</div><div><b>Esempio:</b> <code>backup true</code>.</div>
editor.nod_help.indoprint=<div class="title">indoprint</div><div class="syntax">indoprint Testo introduttivo</div><div><b>Significato:</b> riga di testo introduttivo mostrata prima dell uso.</div><div><b>Esempio:</b> <code>indoprint Testo introduttivo</code>; <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a> chiude il blocco.</div>
editor.nod_help.indoend=<div class="title">indoend</div><div class="syntax">indoend</div><div><b>Significato:</b> fine del blocco introduttivo.</div><div><b>Esempio:</b> <code>indoprint ...</code> + <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</div>
editor.nod_help.end=<div class="title">end</div><div class="syntax">end</div><div><b>Significato:</b> fine del file NOD.</div><div><b>Esempio:</b> metti <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> come ultima riga.</div>
editor.nod_help.insert=Inserisci
editor.nod_insert.indoprint=indoprint Testo introduttivo\nindoend
editor.menu.help=Help
editor.menu.help.nod=NOD help

editor.menu.help.about=Informazioni su NOD Editor
editor.nod_help.more=Altra guida
editor.nod_help.full.title=Guida NOD
editor.nod_help.full.keyword_title=Riferimento comandi
editor.nod_help.full.intro=<p><b>NOD</b> è il linguaggio che descrive i convertitori Syscalculator: nome finestra, campi visibili, simboli vicino ai valori e regole di conversione.</p><p>L editor NOD rende tutto visibile: suggerimenti durante la scrittura, aiuto con clic destro, test in basso e anteprima del convertitore a destra.</p>
editor.nod_help.full.structure=<h2>Struttura base</h2><pre>Name Celsius a Fahrenheit&#13;&#10;URLN Celsius a Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format ##.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre>
editor.nod_help.full.symbols=<h2>Simboli</h2><table><tr><th>Comando</th><th>Posizione</th><th>Esempio</th></tr><tr><td>Symb1</td><td>a sinistra input</td><td>DM 25</td></tr><tr><td>Symb2</td><td>a sinistra output</td><td>EUR 25</td></tr><tr><td>Symb3</td><td>a destra input</td><td>25 kg</td></tr><tr><td>Symb4</td><td>a destra output</td><td>25 lb</td></tr></table><p>Scegli sinistra o destra per valore, non entrambi, per evitare testo doppio come <code>DM 25 DM</code>.</p>
editor.nod_help.full.commands=<h2>Comandi importanti</h2><ul><li><b>math</b>: calcola con <code>ans</code>.</li><li><b>trans</b>: traduce valori di testo esatti.</li><li><b>chg</b>: cambia testo iniziale/prefisso e supporta pattern <code>x</code>.</li><li><b>indoprint ... indoend</b>: blocco di testo introduttivo. Non dimenticare <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</li><li><b>end</b>: chiude il file NOD.</li></ul>
editor.nod_help.full.workflow=<h2>Flusso di lavoro</h2><ol><li>Inizia con <a class="cmd-link" href="nodpage:cmd:name"><code>Name</code></a>, <a class="cmd-link" href="nodpage:cmd:input1"><code>input1</code></a> e <a class="cmd-link" href="nodpage:cmd:input2"><code>input2</code></a>.</li><li>Scegli i simboli con <a class="cmd-link" href="nodpage:cmd:symb1"><code>Symb1</code></a> fino a <a class="cmd-link" href="nodpage:cmd:symb4"><code>Symb4</code></a>; sinistra o destra, non entrambi.</li><li>Aggiungi regole: <a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a>, <a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a> o <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a>.</li><li>Usa Valida/F5 e Test/F6.</li><li>Metti <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> alla fine.</li></ol>
editor.nod_help.full.examples=<h2>Esempi per tipo NOD</h2><p>I file NOD possono descrivere diversi tipi di convertitori.</p><h3>1. Strumento di calcolo con math</h3><p>Per numeri: temperatura, distanza, peso, valuta, percentuale.</p><pre>Name Celsius a Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format ##.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre><h3>2. Strumento di traduzione con trans</h3><p>Usalo quando tutto l input deve corrispondere a un valore noto.</p><pre>Name Postcode a Address demo&#13;&#10;input1 Postcode house number&#13;&#10;input2 Address&#13;&#10;trans "2566 GB 241","Nieboerweg 241, 2566 GB Den Haag"&#13;&#10;end</pre><h3>3. Strumento prefisso/pattern con chg</h3><p>Usa <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a> quando cambia solo l inizio o il pattern.</p><pre>Name Operation Decibel demo&#13;&#10;input1 Old phone number&#13;&#10;input2 New phone number&#13;&#10;chg "01751-xxxxx","070-51xxxxx"&#13;&#10;chg "050-2xxxxx","050-52xxxxx"&#13;&#10;end</pre><h3>4. Strumento con simboli sinistra/destra</h3><p>Usa simboli per mostrare bene le unità.</p><pre>Name German mark a euro&#13;&#10;input1 Mark&#13;&#10;input2 Euro&#13;&#10;Symb1 DM&#13;&#10;Symb2 EUR&#13;&#10;format ##.00&#13;&#10;math ans / 1.95583&#13;&#10;end</pre><h3>5. Testo introduttivo con indoprint</h3><p>Usalo quando l utente deve prima vedere istruzioni.</p><pre>indoprint Questo convertitore cambia Celsius in Fahrenheit.&#13;&#10;indoprint Inserisci una temperatura in gradi Celsius.&#13;&#10;indoend</pre><h3>6. Risoluzione equazione con equation</h3><p>Per problemi di formula con variabile sconosciuta da risolvere.</p><pre>Name Solve equation&#13;&#10;given y = 20&#13;&#10;equation y = x * 2&#13;&#10;solve x&#13;&#10;constraint x >= 0&#13;&#10;end</pre>
editor.nod_help.full.troubleshooting=<h2>Errori comuni</h2><ul><li><b>Simboli doppi:</b> non usare simboli sinistra e destra per lo stesso valore.</li><li><b>Introduzione senza fine:</b> chiudi ogni blocco <a class="cmd-link" href="nodpage:cmd:indoprint"><code>indoprint</code></a> con <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</li><li><b>Math senza ans:</b> usa <code>ans</code> come valore corrente.</li><li><b>Nessun end:</b> metti <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> alla fine del file.</li><li><b>Virgola/punto:</b> testa sempre i decimali con F6.</li></ul>
editor.nod_help.page.workflow=Flusso di lavoro
