editor.nod_help.suggestions=Vorschläge
help.nod_screenshot.converter_name=Celsius nach Fahrenheit
help.nod_screenshot.decimal_factor=1.8
help.nod_screenshot.meaning_label=Bedeutung:
help.nod_screenshot.name_meaning=interner Konvertername.
help.nod_screenshot.example_label=Beispiel:
help.nod_screenshot.example_name=Name Postleitzahl zu Adresse Demo
editor.nod_help.name=<div class="title">Name</div><div class="syntax">Name Celsius nach Fahrenheit</div><div><b>Bedeutung:</b> interner Name des Converters.</div><div><b>Beispiel:</b> <code>Name Postleitzahl zu Adresse Demo</code>.</div>
editor.nod_help.urln=<div class="title">URLN</div><div class="syntax">URLN Benutzertitel</div><div><b>Bedeutung:</b> sichtbarer Titel oder Beschreibung für den Benutzer.</div><div><b>Beispiel:</b> <code>URLN Telefon-Umnummerung 1995 komplett</code>.</div>
editor.nod_help.input1=<div class="title">input1</div><div class="syntax">input1 Celsius</div><div><b>Bedeutung:</b> Beschriftung des Eingabewerts.</div><div><b>Beispiel:</b> <code>input1 Alte Telefonnummer</code>.</div>
editor.nod_help.input2=<div class="title">input2</div><div class="syntax">input2 Fahrenheit</div><div><b>Bedeutung:</b> Beschriftung des Ausgabewerts.</div><div><b>Beispiel:</b> <code>input2 Neue Telefonnummer</code>.</div>
editor.nod_help.symb1=<div class="title">Symb1</div><div class="syntax">Symb1 DM</div><div><b>Bedeutung:</b> Symbol links von input1.</div><div><b>Beispiel:</b> <code>Symb1 DM</code> zeigt <code>DM 25</code>.</div>
editor.nod_help.symb2=<div class="title">Symb2</div><div class="syntax">Symb2 EUR</div><div><b>Bedeutung:</b> Symbol links von input2/Ausgabe.</div><div><b>Beispiel:</b> <code>Symb2 EUR</code> zeigt <code>EUR 12.78</code>.</div>
editor.nod_help.symb3=<div class="title">Symb3</div><div class="syntax">Symb3 kg</div><div><b>Bedeutung:</b> Symbol rechts von input1.</div><div><b>Beispiel:</b> <code>Symb3 kg</code> zeigt <code>25 kg</code>.</div>
editor.nod_help.symb4=<div class="title">Symb4</div><div class="syntax">Symb4 lb</div><div><b>Bedeutung:</b> Symbol rechts von input2/Ausgabe.</div><div><b>Beispiel:</b> <code>Symb4 lb</code> zeigt <code>55 lb</code>.</div>
editor.nod_help.format=<div class="title">format</div><div class="syntax">format ##.00</div><div><b>Bedeutung:</b> steuert, wie viele Dezimalstellen angezeigt werden.</div><div><b>Beispiel:</b> <code>format ##.00</code> zeigt <code>12.50</code>.</div>
editor.nod_help.mode=<div class="title">mode</div><div class="syntax">mode calculator</div><div><b>Bedeutung:</b> zusätzliche Einstellung für den Converter-Typ.</div><div><b>Beispiel:</b> <code>mode calculator</code>.</div>
editor.nod_help.math=<div class="title">math</div><div class="syntax">math ans * 1.8</div><div><b>Bedeutung:</b> führt einen Rechenschritt aus; <code>ans</code> ist der aktuelle Wert.</div><div><b>Beispiel:</b> <code>math ans + 32</code> addiert 32.</div>
editor.nod_help.chg=<div class="title">chg</div><div class="syntax">chg "alter-prefix","neuer-prefix"</div><div><b>Bedeutung:</b> ändert den Anfang eines Textes, zum Beispiel Codes oder Telefonnummern.</div><div><b>Beispiel:</b> <code>chg "01751-xxxxx","070-51xxxxx"</code> macht aus <code>01751-12345</code> den Wert <code>070-5112345</code>.</div><div><b>Muster:</b> <code>x</code> kann Ziffern erfassen. Bei mehreren Treffern gewinnt die längste/spezifischste Regel.</div>
editor.nod_help.trans=<div class="title">trans</div><div class="syntax">trans "alter Wert","neuer Wert"</div><div><b>Bedeutung:</b> übersetzt einen exakten Textwert.</div><div><b>Beispiel:</b> <code>trans "hallo","hello"</code> übersetzt <code>hallo</code> nach <code>hello</code>.</div>

editor.nod_help.trans.improved=<h2>Verbessertes trans: schlauer als NOD 1.0</h2><div class="notice improved"><b>Kompatibel:</b> klassisches NOD 1.0 <code>trans</code> versucht zuerst exakte Treffer. NOD 2.0 versucht erst danach einen kompakten, smarten Treffer.</div><table class="syntax-compare"><tr><th>Verhalten</th><th>NOD 1.0</th><th>NOD 2.0</th><th>Beispiel</th></tr><tr><td>Exakter Wert</td><td><span class="yes">&#10003;</span></td><td><span class="yes">&#10003;</span></td><td><code>trans "hallo","hello"</code></td></tr><tr><td>Groß-/Kleinschreibung ignorieren</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>Hallo</code> trifft <code>hallo</code></td></tr><tr><td>Leerzeichen, Punkte, Bindestriche und Unterstrich ignorieren</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>dank_je</code>, <code>dank je</code> und <code>dank-je</code> können dieselbe Regel treffen</td></tr><tr><td>Mehrdeutiger smarter Treffer</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td>Bei zwei kompakten Treffern wird nicht still falsch übersetzt; die Eingabe bleibt stehen.</td></tr></table>
editor.nod_help.reverse=<div class="title">reverse</div><div class="syntax">reverse ans / 1.8</div><div><b>Bedeutung:</b> manuelle Rückrechnungsregel.</div><div><b>Beispiel:</b> zu <code>math ans * 1.8</code> passt <code>reverse ans / 1.8</code>.</div>
editor.nod_help.field=<div class="title">field</div><div class="syntax">field Spaltenname</div><div><b>Bedeutung:</b> startet eine Datenfeld-Definition.</div><div><b>Beispiel:</b> <code>field Phone</code>.</div>
editor.nod_help.table=<div class="title">table</div><div class="syntax">table Tabellenname</div><div><b>Bedeutung:</b> Name der Quelltabelle.</div><div><b>Beispiel:</b> <code>table Customers</code>.</div>
editor.nod_help.output=<div class="title">output</div><div class="syntax">output ErgebnisSpalte</div><div><b>Bedeutung:</b> Name des Ausgabefeldes.</div><div><b>Beispiel:</b> <code>output PhoneNew</code>.</div>
editor.nod_help.phoneformat=<div class="title">phoneformat</div><div class="syntax">phoneformat country NL</div><div><b>Bedeutung:</b> normalisiert Telefonnummern innerhalb eines <code>field</code>-Blocks in <code>mode data</code>.</div><div><b>Beispiel:</b> <code>phoneformat remove_spaces true</code> entfernt Leerzeichen; <code>phoneformat normalize_international true</code> normalisiert niederländische internationale Schreibweise.</div>
editor.nod_help.lookup=<div class="title">lookup</div><div class="syntax">lookup Countries</div><div><b>Bedeutung:</b> startet eine Nachschlage-Definition.</div><div><b>Beispiel:</b> <code>lookup Countries</code>.</div>
editor.nod_help.match=<div class="title">match</div><div class="syntax">match code = NL</div><div><b>Bedeutung:</b> beschreibt, wie ein Lookup gefunden wird.</div><div><b>Beispiel:</b> <code>match postcode = 2566GB</code>.</div>
editor.nod_help.given=<div class="title">given</div><div class="syntax">given x = 10</div><div><b>Bedeutung:</b> bekannter Wert für eine Gleichung.</div><div><b>Beispiel:</b> <code>given y = 20</code>.</div>
editor.nod_help.equation=<div class="title">equation</div><div class="syntax">equation y = x * 2</div><div><b>Bedeutung:</b> definiert eine Gleichung.</div><div><b>Beispiel:</b> <code>equation y = x * 2</code>.</div>
editor.nod_help.solve=<div class="title">solve</div><div class="syntax">solve x</div><div><b>Bedeutung:</b> sagt, welche Variable gelöst werden soll.</div><div><b>Beispiel:</b> <code>solve x</code>.</div>
editor.nod_help.constraint=<div class="title">constraint</div><div class="syntax">constraint x >= 0</div><div><b>Bedeutung:</b> Bedingung für eine Lösung.</div><div><b>Beispiel:</b> <code>constraint x >= 0</code> verhindert negative Lösungen.</div>
editor.nod_help.preview=<div class="title">preview</div><div class="syntax">preview Beispieltext</div><div><b>Bedeutung:</b> Text für Vorschau oder Beispieldarstellung.</div><div><b>Beispiel:</b> <code>preview Gib 2566 GB 241 ein</code>.</div>
editor.nod_help.backup=<div class="title">backup</div><div class="syntax">backup true</div><div><b>Bedeutung:</b> Kompatibilitätseinstellung aus älteren NOD-Dateien.</div><div><b>Beispiel:</b> <code>backup true</code>.</div>
editor.nod_help.indoprint=<div class="title">indoprint</div><div class="syntax">indoprint Einführungstext</div><div><b>Bedeutung:</b> eine Zeile Einführungstext, die vor der Nutzung gezeigt wird.</div><div><b>Beispiel:</b> <code>indoprint Dieser Converter nutzt die Decibel-Tabelle.</code> Danach mit <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a> schließen.</div>
editor.nod_help.indoend=<div class="title">indoend</div><div class="syntax">indoend</div><div><b>Bedeutung:</b> Ende eines Einführungstextblocks.</div><div><b>Beispiel:</b> <code>indoprint Hilfetext</code> gefolgt von <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</div>
editor.nod_help.end=<div class="title">end</div><div class="syntax">end</div><div><b>Bedeutung:</b> Ende der NOD-Datei.</div><div><b>Beispiel:</b> <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> als letzte Zeile setzen.</div>
editor.nod_help.insert=Einfügen
editor.nod_insert.indoprint=indoprint Einführungstext\nindoend
editor.menu.help=Help
editor.menu.help.nod=NOD help

editor.menu.help.about=Info zum NOD-Editor
editor.nod_help.more=Mehr Hilfe
editor.nod_help.full.title=NOD-Hilfe
editor.nod_help.full.keyword_title=Befehlsreferenz
editor.nod_help.full.intro=<p><b>NOD</b> ist die Sprache, mit der Syscalculator-Converter beschrieben werden. Eine NOD-Datei legt fest, wie das Fenster heißt, welche Felder sichtbar sind, welche Symbole neben Werten stehen und welche Regeln die Umrechnung ausführen.</p><p>Der NOD-Editor macht das sichtbar: beim Tippen erscheinen Vorschläge, Rechtsklick zeigt Befehlshilfe, unten testest du Eingaben und rechts zeigt die Vorschau das Converterfenster.</p>
editor.nod_help.full.structure=<h2>Grundstruktur</h2><pre>Name Celsius nach Fahrenheit&#13;&#10;URLN Celsius nach Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format ##.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre>
editor.nod_help.full.symbols=<h2>Symbole</h2><table><tr><th>Befehl</th><th>Position</th><th>Beispiel</th></tr><tr><td>Symb1</td><td>links von input1</td><td>DM 25</td></tr><tr><td>Symb2</td><td>links von input2/Ausgabe</td><td>EUR 25</td></tr><tr><td>Symb3</td><td>rechts von input1</td><td>25 kg</td></tr><tr><td>Symb4</td><td>rechts von input2/Ausgabe</td><td>25 lb</td></tr></table><p>Wähle pro Wert meistens links oder rechts, nicht beides. Sonst entsteht doppelte Anzeige wie <code>DM 25 DM</code>.</p>
editor.nod_help.full.commands=<h2>Wichtige Befehle</h2><ul><li><b>math</b>: rechnet mit <code>ans</code>.</li><li><b>trans</b>: übersetzt exakte Textwerte.</li><li><b>chg</b>: ändert Anfangstext/Prefix; unterstützt auch <code>x</code>-Muster wie <code>050-2xxxxx</code>. Die spezifischste Regel gewinnt.</li><li><b>indoprint ... indoend</b>: Einführungstextblock. <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a> nicht vergessen.</li><li><b>end</b>: schließt die NOD-Datei ab.</li></ul>
editor.nod_help.full.workflow=<h2>Arbeitsweise</h2><ol><li>Beginne mit <a class="cmd-link" href="nodpage:cmd:name"><code>Name</code></a>, <a class="cmd-link" href="nodpage:cmd:input1"><code>input1</code></a> und <a class="cmd-link" href="nodpage:cmd:input2"><code>input2</code></a>; dann hat der Converter einen Namen und sichtbare Beschriftungen.</li><li>Wähle optional Symbole mit <a class="cmd-link" href="nodpage:cmd:symb1"><code>Symb1</code></a> bis <a class="cmd-link" href="nodpage:cmd:symb4"><code>Symb4</code></a>. Benutze pro Wert links oder rechts, nicht beides.</li><li>Füge Umrechnungsregeln hinzu: <a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a> für Berechnungen, <a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a> für exakte Textübersetzung, <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a> für Prefix- oder Musteränderungen.</li><li>Nutze <b>Validieren</b> oder F5 für Syntaxprüfung und <b>Test</b> oder F6 für das Ergebnis.</li><li>Setze <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> ans Ende.</li></ol>
editor.nod_help.full.examples=<h2>Beispiele nach NOD-Typ</h2><p>NOD-Dateien können verschiedene Arten von Convertern beschreiben. Wähle das Muster, das zu deinem Werkzeug passt.</p><h3>1. Rechentool mit math</h3><p>Für Zahlen: Temperatur, Abstand, Gewicht, Währung, Prozent.</p><pre>Name Celsius nach Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format ##.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre><h3>2. Übersetzungstool mit trans</h3><p>Benutze dies, wenn die ganze Eingabe exakt einem bekannten Wert entsprechen muss. Alt und neu werden mit Komma getrennt. Werte mit Leerzeichen oder Komma kommen in Anführungszeichen.</p><pre>Name Postleitzahl zu Adresse Demo&#13;&#10;input1 Postleitzahl Hausnummer&#13;&#10;input2 Adresse&#13;&#10;trans "2566 GB 241","Nieboerweg 241, 2566 GB Den Haag"&#13;&#10;end</pre><h3>3. Prefix-/Muster-Tool mit chg</h3><p>Benutze <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a>, wenn nur der Anfang oder ein Muster geändert wird. <code>x</code>-Muster sind erlaubt, nützlich für alte Telefon-Umnummerungstabellen.</p><pre>Name Operation Decibel Beispiel&#13;&#10;input1 Alte Telefonnummer&#13;&#10;input2 Neue Telefonnummer&#13;&#10;chg "01751-xxxxx","070-51xxxxx"&#13;&#10;chg "050-2xxxxx","050-52xxxxx"&#13;&#10;end</pre><h3>4. Tool mit Symbolen links/rechts</h3><p>Symbole zeigen Einheiten sauber im Fenster. Wähle pro Wert links oder rechts.</p><pre>Name Deutsche Mark nach Euro&#13;&#10;input1 Mark&#13;&#10;input2 Euro&#13;&#10;Symb1 DM&#13;&#10;Symb2 EUR&#13;&#10;format ##.00&#13;&#10;math ans / 1.95583&#13;&#10;end</pre><h3>5. Einführungstext mit indoprint</h3><p>Damit sieht der Benutzer zuerst eine Erklärung.</p><pre>indoprint Dieser Converter rechnet Celsius nach Fahrenheit.&#13;&#10;indoprint Gib eine Temperatur in Grad Celsius ein.&#13;&#10;indoend</pre><h3>6. Gleichung lösen mit equation</h3><p>Für formelartige Probleme, bei denen eine unbekannte Variable gelöst werden soll.</p><pre>Name Gleichung lösen&#13;&#10;given y = 20&#13;&#10;equation y = x * 2&#13;&#10;solve x&#13;&#10;constraint x >= 0&#13;&#10;end</pre><h3>7. Beispiel wie im Fenster</h3><p>Dieses Beispiel zeigt, wo Beschriftungen, Eingabe, Ergebnis und Symbole im Fenster erscheinen.</p><div class="dialog-example"><div class="dialog-title">EuroCalculator</div><div class="dialog-menu"><span>Datei</span><span>Bearbeiten</span><span>Config</span><span>Extra</span><span>Über</span></div><div class="dialog-body"><div class="dialog-row"><span></span><div class="dialog-label">Wert in Deutscher Mark</div><span></span></div><div class="dialog-row"><span class="dialog-radio on"></span><div class="dialog-input">22</div><div class="dialog-symbol">DM</div></div><div class="dialog-row"><span></span><div class="dialog-label">Wert in Euro</div><span></span></div><div class="dialog-row"><span class="dialog-radio"></span><div class="dialog-input">11.25</div><span></span></div><div class="dialog-options"><span>□ Gruppieren</span><span>☑ Dezimalen</span><span>2</span></div></div></div><pre>Name Deutsche Mark nach Euro&#13;&#10;input1 Wert in Deutscher Mark&#13;&#10;input2 Wert in Euro&#13;&#10;Symb3 DM&#13;&#10;format ##.00&#13;&#10;math ans / 1.95583&#13;&#10;end</pre>
editor.nod_help.full.troubleshooting=<h2>Häufige Fehler</h2><ul><li><b>Doppelte Symbole:</b> benutze nicht links und rechts für denselben Wert, sonst entsteht Text wie <code>DM 25 DM</code>.</li><li><b>Einführung ohne Ende:</b> jeden <a class="cmd-link" href="nodpage:cmd:indoprint"><code>indoprint</code></a>-Block mit <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a> schließen.</li><li><b>Math ohne ans:</b> benutze <code>ans</code> als aktuellen Wert, zum Beispiel <code>math ans * 100</code>.</li><li><b>Kein end:</b> setze <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> ans Dateiende.</li><li><b>Komma/Punkt:</b> Dezimalzahlen können oft mit Komma oder Punkt funktionieren; immer mit F6 testen.</li></ul>
editor.nod_help.page.workflow=Arbeitsweise
