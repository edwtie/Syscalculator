editor.nod_help.suggestions=Suggestions
help.nod_screenshot.converter_name=Celsius vers Fahrenheit
help.nod_screenshot.decimal_factor=1.8
help.nod_screenshot.meaning_label=Signification:
help.nod_screenshot.name_meaning=nom interne du convertisseur.
help.nod_screenshot.example_label=Exemple:
help.nod_screenshot.example_name=Name Postcode vers adresse demo
editor.nod_help.name=<div class="title">Name</div><div class="syntax">Name Celsius vers Fahrenheit</div><div><b>Signification:</b> nom interne du convertisseur.</div><div><b>Exemple:</b> <code>Name Postcode vers Address demo</code>.</div>
editor.nod_help.urln=<div class="title">URLN</div><div class="syntax">URLN Titre utilisateur</div><div><b>Signification:</b> titre visible ou description pour l utilisateur.</div><div><b>Exemple:</b> <code>URLN Phone renumbering 1995 complete</code>.</div>
editor.nod_help.input1=<div class="title">input1</div><div class="syntax">input1 Celsius</div><div><b>Signification:</b> libellé de la valeur d entrée.</div><div><b>Exemple:</b> <code>input1 Old phone number</code>.</div>
editor.nod_help.input2=<div class="title">input2</div><div class="syntax">input2 Fahrenheit</div><div><b>Signification:</b> libellé de la valeur de sortie.</div><div><b>Exemple:</b> <code>input2 New phone number</code>.</div>
editor.nod_help.symb1=<div class="title">Symb1</div><div class="syntax">Symb1 DM</div><div><b>Signification:</b> symbole à gauche de input1.</div><div><b>Exemple:</b> <code>Symb1 DM</code> -> <code>DM 25</code>.</div>
editor.nod_help.symb2=<div class="title">Symb2</div><div class="syntax">Symb2 EUR</div><div><b>Signification:</b> symbole à gauche de input2/sortie.</div><div><b>Exemple:</b> <code>Symb2 EUR</code> -> <code>EUR 12.78</code>.</div>
editor.nod_help.symb3=<div class="title">Symb3</div><div class="syntax">Symb3 kg</div><div><b>Signification:</b> symbole à droite de input1.</div><div><b>Exemple:</b> <code>Symb3 kg</code> -> <code>25 kg</code>.</div>
editor.nod_help.symb4=<div class="title">Symb4</div><div class="syntax">Symb4 lb</div><div><b>Signification:</b> symbole à droite de input2/sortie.</div><div><b>Exemple:</b> <code>Symb4 lb</code> -> <code>55 lb</code>.</div>
editor.nod_help.format=<div class="title">format</div><div class="syntax">format ##.00</div><div><b>Signification:</b> contrôle les décimales du résultat.</div><div><b>Exemple:</b> <code>format ##.00</code> -> <code>12.50</code>.</div>
editor.nod_help.mode=<div class="title">mode</div><div class="syntax">mode calculator</div><div><b>Signification:</b> réglage supplémentaire du type de convertisseur.</div><div><b>Exemple:</b> <code>mode calculator</code>.</div>
editor.nod_help.math=<div class="title">math</div><div class="syntax">math ans * 1.8</div><div><b>Signification:</b> exécute une étape de calcul avec <code>ans</code> comme valeur courante.</div><div><b>Exemple:</b> <code>math ans + 32</code>.</div>
editor.nod_help.chg=<div class="title">chg</div><div class="syntax">chg "old-prefix","new-prefix"</div><div><b>Signification:</b> change le début du texte, par exemple codes ou numéros.</div><div><b>Exemple:</b> <code>chg "01751-xxxxx","070-51xxxxx"</code>.</div><div><b>Patterns:</b> <code>x</code> peut capturer des chiffres; la règle la plus spécifique gagne.</div>
editor.nod_help.trans=<div class="title">trans</div><div class="syntax">trans "old value","new value"</div><div><b>Signification:</b> traduit une valeur texte exacte.</div><div><b>Exemple:</b> <code>trans "hallo","hello"</code>.</div>

editor.nod_help.trans.improved=<h2>trans amélioré : plus intelligent que NOD 1.0</h2><div class="notice improved"><b>Compatible :</b> le <code>trans</code> classique de NOD 1.0 cherche d'abord une correspondance exacte. NOD 2.0 essaie seulement ensuite une correspondance compacte.</div><table class="syntax-compare"><tr><th>Comportement</th><th>NOD 1.0</th><th>NOD 2.0</th><th>Exemple</th></tr><tr><td>Valeur exacte</td><td><span class="yes">&#10003;</span></td><td><span class="yes">&#10003;</span></td><td><code>trans "hallo","hello"</code></td></tr><tr><td>Ignorer la casse</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>Hallo</code> correspond à <code>hallo</code></td></tr><tr><td>Ignorer espaces, points, tirets et underscore</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td><code>dank_je</code>, <code>dank je</code> et <code>dank-je</code> peuvent utiliser la même règle</td></tr><tr><td>Correspondance ambiguë</td><td><span class="no">&#10005;</span></td><td><span class="yes">&#10003;</span></td><td>S'il y a deux correspondances compactes, le texte n'est pas traduit silencieusement de travers.</td></tr></table>
editor.nod_help.reverse=<div class="title">reverse</div><div class="syntax">reverse ans / 1.8</div><div><b>Signification:</b> règle manuelle de calcul inverse.</div><div><b>Exemple:</b> <code>reverse ans / 1.8</code>.</div>
editor.nod_help.field=<div class="title">field</div><div class="syntax">field ColumnName</div><div><b>Signification:</b> démarre une définition de champ.</div><div><b>Exemple:</b> <code>field Phone</code>.</div>
editor.nod_help.table=<div class="title">table</div><div class="syntax">table TableName</div><div><b>Signification:</b> nom de la table source.</div><div><b>Exemple:</b> <code>table Customers</code>.</div>
editor.nod_help.output=<div class="title">output</div><div class="syntax">output ResultColumn</div><div><b>Signification:</b> nom du champ de sortie.</div><div><b>Exemple:</b> <code>output PhoneNew</code>.</div>
editor.nod_help.phoneformat=<div class="title">phoneformat</div><div class="syntax">phoneformat country NL</div><div><b>Signification:</b> normalise les numéros de téléphone dans un bloc <code>field</code> de <code>mode data</code>.</div><div><b>Exemple:</b> <code>phoneformat remove_spaces true</code> supprime les espaces; <code>phoneformat normalize_international true</code> normalise la notation internationale néerlandaise.</div>
editor.nod_help.lookup=<div class="title">lookup</div><div class="syntax">lookup Countries</div><div><b>Signification:</b> démarre une définition de recherche.</div><div><b>Exemple:</b> <code>lookup Countries</code>.</div>
editor.nod_help.match=<div class="title">match</div><div class="syntax">match code = NL</div><div><b>Signification:</b> décrit comment une recherche correspond.</div><div><b>Exemple:</b> <code>match postcode = 2566GB</code>.</div>
editor.nod_help.given=<div class="title">given</div><div class="syntax">given x = 10</div><div><b>Signification:</b> valeur connue pour une équation.</div><div><b>Exemple:</b> <code>given y = 20</code>.</div>
editor.nod_help.equation=<div class="title">equation</div><div class="syntax">equation y = x * 2</div><div><b>Signification:</b> définit une équation.</div><div><b>Exemple:</b> <code>equation y = x * 2</code>.</div>
editor.nod_help.solve=<div class="title">solve</div><div class="syntax">solve x</div><div><b>Signification:</b> indique quelle variable résoudre.</div><div><b>Exemple:</b> <code>solve x</code>.</div>
editor.nod_help.constraint=<div class="title">constraint</div><div class="syntax">constraint x >= 0</div><div><b>Signification:</b> condition pour une solution.</div><div><b>Exemple:</b> <code>constraint x >= 0</code>.</div>
editor.nod_help.preview=<div class="title">preview</div><div class="syntax">preview Example text</div><div><b>Signification:</b> texte pour aperçu/exemple.</div><div><b>Exemple:</b> <code>preview Enter 2566 GB 241</code>.</div>
editor.nod_help.backup=<div class="title">backup</div><div class="syntax">backup true</div><div><b>Signification:</b> réglage de compatibilité des anciens fichiers NOD.</div><div><b>Exemple:</b> <code>backup true</code>.</div>
editor.nod_help.indoprint=<div class="title">indoprint</div><div class="syntax">indoprint Texte d introduction</div><div><b>Signification:</b> ligne de texte d introduction affichée avant usage.</div><div><b>Exemple:</b> <code>indoprint Texte d introduction</code>; <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a> ferme le bloc.</div>
editor.nod_help.indoend=<div class="title">indoend</div><div class="syntax">indoend</div><div><b>Signification:</b> fin d un bloc de texte d introduction.</div><div><b>Exemple:</b> <code>indoprint ...</code> + <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</div>
editor.nod_help.end=<div class="title">end</div><div class="syntax">end</div><div><b>Signification:</b> fin du fichier NOD.</div><div><b>Exemple:</b> place <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> comme dernière ligne.</div>
editor.nod_help.insert=Insérer
editor.nod_insert.indoprint=indoprint Texte d introduction\nindoend
editor.menu.help=Help
editor.menu.help.nod=NOD help

editor.menu.help.about=A propos de l éditeur NOD
editor.nod_help.more=Plus d aide
editor.nod_help.full.title=Aide NOD
editor.nod_help.full.keyword_title=Référence des commandes
editor.nod_help.full.intro=<p><b>NOD</b> est le langage qui décrit les convertisseurs Syscalculator : nom de fenêtre, champs visibles, symboles près des valeurs et règles de conversion.</p><p>L éditeur NOD rend cela visible : suggestions pendant la saisie, aide par clic droit, panneau de test en bas et aperçu du convertisseur à droite.</p>
editor.nod_help.full.structure=<h2>Structure de base</h2><pre>Name Celsius vers Fahrenheit&#13;&#10;URLN Celsius vers Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format ##.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre>
editor.nod_help.full.symbols=<h2>Symboles</h2><table><tr><th>Commande</th><th>Position</th><th>Exemple</th></tr><tr><td>Symb1</td><td>à gauche de input</td><td>DM 25</td></tr><tr><td>Symb2</td><td>à gauche de output</td><td>EUR 25</td></tr><tr><td>Symb3</td><td>à droite de input</td><td>25 kg</td></tr><tr><td>Symb4</td><td>à droite de output</td><td>25 lb</td></tr></table><p>Choisis gauche ou droite par valeur, pas les deux, pour éviter <code>DM 25 DM</code>.</p>
editor.nod_help.full.commands=<h2>Commandes importantes</h2><ul><li><b>math</b>: calcule avec <code>ans</code>.</li><li><b>trans</b>: traduit des valeurs texte exactes.</li><li><b>chg</b>: change le début/préfixe et accepte les motifs avec <code>x</code>.</li><li><b>indoprint ... indoend</b>: bloc de texte d introduction. Ne pas oublier <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</li><li><b>end</b>: ferme le fichier NOD.</li></ul>
editor.nod_help.full.workflow=<h2>Méthode</h2><ol><li>Commence avec <a class="cmd-link" href="nodpage:cmd:name"><code>Name</code></a>, <a class="cmd-link" href="nodpage:cmd:input1"><code>input1</code></a> et <a class="cmd-link" href="nodpage:cmd:input2"><code>input2</code></a>.</li><li>Choisis les symboles avec <a class="cmd-link" href="nodpage:cmd:symb1"><code>Symb1</code></a> à <a class="cmd-link" href="nodpage:cmd:symb4"><code>Symb4</code></a>; gauche ou droite, pas les deux.</li><li>Ajoute les règles : <a class="cmd-link" href="nodpage:cmd:math"><code>math</code></a>, <a class="cmd-link" href="nodpage:cmd:trans"><code>trans</code></a> ou <a class="cmd-link" href="nodpage:cmd:chg"><code>chg</code></a>.</li><li>Utilise Valider/F5 et Test/F6.</li><li>Place <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> à la fin.</li></ol>
editor.nod_help.full.examples=<h2>Exemples par type NOD</h2><p>Les fichiers NOD peuvent décrire différents convertisseurs.</p><h3>1. Outil de calcul avec math</h3><p>Pour nombres : température, distance, poids, devise, pourcentage.</p><pre>Name Celsius vers Fahrenheit&#13;&#10;input1 Celsius&#13;&#10;input2 Fahrenheit&#13;&#10;format ##.00&#13;&#10;math ans * 1.8&#13;&#10;math ans + 32&#13;&#10;end</pre><h3>2. Outil de traduction avec trans</h3><p>Quand toute l entrée doit correspondre exactement.</p><pre>Name Postcode vers Address demo&#13;&#10;input1 Postcode house number&#13;&#10;input2 Address&#13;&#10;trans "2566 GB 241","Nieboerweg 241, 2566 GB Den Haag"&#13;&#10;end</pre><h3>3. Outil préfixe/motif avec chg</h3><p>Quand seul le début ou le motif change.</p><pre>Name Operation Decibel demo&#13;&#10;input1 Old phone number&#13;&#10;input2 New phone number&#13;&#10;chg "01751-xxxxx","070-51xxxxx"&#13;&#10;chg "050-2xxxxx","050-52xxxxx"&#13;&#10;end</pre><h3>4. Outil avec symboles gauche/droite</h3><p>Pour afficher proprement les unités.</p><pre>Name German mark vers euro&#13;&#10;input1 Mark&#13;&#10;input2 Euro&#13;&#10;Symb1 DM&#13;&#10;Symb2 EUR&#13;&#10;format ##.00&#13;&#10;math ans / 1.95583&#13;&#10;end</pre><h3>5. Texte d introduction avec indoprint</h3><p>Quand l utilisateur doit d abord voir des instructions.</p><pre>indoprint Ce convertisseur change Celsius en Fahrenheit.&#13;&#10;indoprint Saisis une température en degrés Celsius.&#13;&#10;indoend</pre><h3>6. Résolution avec equation</h3><p>Pour les problèmes où une variable inconnue doit être résolue.</p><pre>Name Solve equation&#13;&#10;given y = 20&#13;&#10;equation y = x * 2&#13;&#10;solve x&#13;&#10;constraint x >= 0&#13;&#10;end</pre>
editor.nod_help.full.troubleshooting=<h2>Erreurs fréquentes</h2><ul><li><b>Symboles doubles:</b> ne mets pas un symbole à gauche et à droite pour la même valeur.</li><li><b>Introduction sans fin:</b> ferme chaque bloc <a class="cmd-link" href="nodpage:cmd:indoprint"><code>indoprint</code></a> avec <a class="cmd-link" href="nodpage:cmd:indoend"><code>indoend</code></a>.</li><li><b>Math sans ans:</b> utilise <code>ans</code> comme valeur courante.</li><li><b>Pas de end:</b> place <a class="cmd-link" href="nodpage:cmd:end"><code>end</code></a> à la fin du fichier.</li><li><b>Virgule/point:</b> teste toujours les décimales avec F6.</li></ul>
