Root: HKCU; Subkey: Software\Microsoft\Windows\CurrentVersion\Run; ValueName: Syscal; Flags: uninsdeletevalue
Root: HKCR; SubKey: ft000002; ValueType: string; ValueData: ; Flags: uninsdeletekey
