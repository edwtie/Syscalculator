Root: HKCR; SubKey: ft000002; ValueType: dword; ValueName: BrowserFlags; ValueData: 00000008; Flags: uninsdeletekey
Root: HKCR; SubKey: ft000002\DefaultIcon; ValueType: string; ValueData: {app}\freesyscal.exe,0; Flags: uninsdeletekey
