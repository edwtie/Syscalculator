Root: HKCR; SubKey: ft000002\Shell\open\command; ValueType: string; ValueData: """{app}\freesyscal.exe"" %1"; Flags: uninsdeletekey
Root: HKCR; SubKey: ft000002\Shell\open\ddeexec; Flags: uninsdeletekey
